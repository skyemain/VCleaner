<Window x:Class="Clenzy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Clenzy.App.Views"
        xmlns:vm="clr-namespace:Clenzy.Presentation.ViewModels;assembly=Clenzy.Presentation"
        Title="Clenzy" Width="1120" Height="680" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}" TextElement.Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="Assets/Clenzy.ico"
        AutomationProperties.Name="Clenzy">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ReviewViewModel}"><views:ReviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DetailsViewModel}"><views:DetailsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegistryReviewViewModel}"><views:RegistryReviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="{DynamicResource AmbientBrush}" IsHitTestVisible="False" />

        <Grid Margin="40,18,32,6" Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/Clenzy.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="CLENZY" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ShortVersion}" Style="{StaticResource SecondaryText}" FontFamily="{StaticResource MonoFont}"
                           FontSize="11" Margin="10,2,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Debloat" FontSize="12" Padding="16,8" Margin="0,0,12,0" Click="DebloatClick"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE713;"
                    Command="{Binding OpenSettingsCommand}" ToolTip="Settings"
                    AutomationProperties.Name="Settings" />
            </StackPanel>
        </Grid>

        <Grid Margin="32,18,40,6" Visibility="{Binding IsHome, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" Command="{Binding CurrentPage.BackCommand}"
                    ToolTip="Back" AutomationProperties.Name="Back" />
            <TextBlock Grid.Column="1" Text="{Binding CurrentPage.Title}" Style="{StaticResource PageTitle}"
                       VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.HeadingLevel="Level1" />
        </Grid>

        <Border x:Name="DebloatSurface" Grid.RowSpan="2" Panel.ZIndex="10" Visibility="Collapsed" Background="{DynamicResource WindowBackgroundBrush}"><ContentControl x:Name="DebloatHost"/></Border>
        <Grid Grid.Row="1">
            <views:HomeView Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}" />
            <ContentControl Content="{Binding CurrentPage}" IsTabStop="False"
                            Visibility="{Binding IsHome, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
    </Grid>
</Window>
