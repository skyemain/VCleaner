<Application x:Class="Clenzy.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Clenzy.App.Services"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <svc:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <svc:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
            <svc:CountToVisibilityConverter x:Key="CountToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
