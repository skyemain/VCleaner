<Window x:Class="Clenzy.App.Views.Windows11CleanupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Clenzy · Windows 11 Cleanup" Width="1040" Height="780" MinWidth="820" MinHeight="600"
 Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterOwner">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="WINDOWS 11 CLEANUP" FontSize="25" FontWeight="SemiBold"/>
   <TextBlock Text="Scan. Choose what changes. Keep a way back." Style="{StaticResource SecondaryText}" Margin="0,6,0,14"/>
   <WrapPanel>
    <CheckBox x:Name="Sandbox" Content="Sandbox preview · generated fixtures, no Windows changes" IsChecked="True" Margin="0,0,18,10" Checked="EnvironmentChanged" Unchecked="EnvironmentChanged"/>
    <ComboBox x:Name="Profile" Width="130" SelectedIndex="0" SelectionChanged="ProfileChanged"><ComboBoxItem Content="Safe"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Advanced"/></ComboBox>
   </WrapPanel>
  </StackPanel>
  <StackPanel Grid.Row="1">
   <TextBlock x:Name="Status" Text="Sandbox preview is ready. Scan to review generated findings." Margin="0,10" TextWrapping="Wrap"/>
   <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="3" Visibility="Collapsed"/>
  </StackPanel>
  <WrapPanel Grid.Row="2" Margin="0,12">
   <Button x:Name="Scan" Content="Scan" Click="ScanClick" Margin="0,0,8,0"/>
   <Button x:Name="Apply" Content="Review selected changes" Click="ApplyClick" IsEnabled="False" Margin="0,0,8,0"/>
   <Button x:Name="Cancel" Content="Cancel" Click="CancelClick" IsEnabled="False" Margin="0,0,8,0"/>
   <Button Content="Open reports &amp; backups" Click="ReportsClick" Margin="0,0,8,0"/>
   <Button Content="Review disk cleanup" Click="DiskCleanupClick" Margin="0,0,8,0"/>
   <Button Content="Restart as administrator" Click="AdministratorClick" Margin="0,0,8,0"/>
   <Button Content="Run in Windows Sandbox" Click="LaunchSandboxClick"/>
  </WrapPanel>
  <TabControl Grid.Row="3">
   <TabItem Header="Review changes">
    <DockPanel>
     <WrapPanel DockPanel.Dock="Top" Margin="8"><TextBox x:Name="Search" Width="230" TextChanged="FilterChanged" ToolTip="Filter by app, category or setting"/><CheckBox x:Name="AvailableOnly" Content="Available only" Margin="12,4" Checked="FilterChanged" Unchecked="FilterChanged"/><Button Content="Select available Safe changes" Click="SelectSafeClick" Margin="12,0"/></WrapPanel>
    <ListBox x:Name="Findings" BorderThickness="0" HorizontalContentAlignment="Stretch">
     <ListBox.ItemTemplate><DataTemplate>
      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SecondaryTextBrush}" Padding="12">
       <StackPanel>
        <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding Enabled}" Content="{Binding Title}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="24,5,0,0"/>
       </StackPanel>
      </Border>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    </DockPanel>
   </TabItem>
   <TabItem Header="System review">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
     <TextBlock Text="These controls open Windows' own supported review screens. Clenzy does not claim a performance or gaming improvement without measurements." Margin="0,0,0,12"/>
     <WrapPanel x:Name="SettingsLinks"/>
     <TextBlock Text="Startup changes cover detected current-user Run entries for supported optional apps. Service changes cover only stopped, dependency-free optional services in the catalog. Scheduled tasks, provisioned packages, drivers, antivirus and shared AI frameworks are preserved. Disk cleanup uses Clenzy’s existing review engine." Style="{StaticResource SecondaryText}" Margin="0,14"/>
     <Expander Header="Hardware, security, packages, startup, services and tasks audit"><TextBox x:Name="AuditText" IsReadOnly="True" TextWrapping="Wrap" Height="300" VerticalScrollBarVisibility="Auto"/></Expander>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Restore &amp; activity">
    <StackPanel Margin="14">
     <TextBlock Text="Restore reverses settings from a saved transaction, checking for later changes first. App removals require Microsoft Store reinstallation; original app data is not restored."/>
     <ComboBox x:Name="Backups" Margin="0,14"/>
     <Button x:Name="Restore" Content="Review and restore selected backup" Click="RestoreClick" HorizontalAlignment="Left"/>
     <TextBox x:Name="Activity" IsReadOnly="True" Height="260" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,14"/>
    </StackPanel>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="4" Text="Safe: reversible preferences. Balanced: optional startup and shell changes. Advanced: reviewed app removal, policies and optional services. Registry verification confirms stored values; Windows may require sign-out/restart. No speed improvement is claimed without measurement." Style="{StaticResource SecondaryText}" Margin="0,12"/>
  <Button Grid.Row="5" Content="Done" HorizontalAlignment="Right" Click="DoneClick"/>
 </Grid>
</Window>
