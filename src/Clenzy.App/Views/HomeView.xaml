<UserControl x:Class="Clenzy.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Clenzy.App.Views"
             xmlns:vm="clr-namespace:Clenzy.Presentation.ViewModels;assembly=Clenzy.Presentation">
    <Grid Margin="40,0,40,28" MaxWidth="1240">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,40,0">
            <Button Style="{StaticResource HeroButton}" Content="{Binding PrimaryButtonText}" Command="{Binding PrimaryCommand}"
                    HorizontalAlignment="Center" Margin="0,8,0,0"
                    AutomationProperties.Name="{Binding PrimaryButtonText}"
                    AutomationProperties.HelpText="Scans your PC, then removes the junk that is safe to remove." />

            <Border Margin="0,22,0,0" Padding="16,10" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}"
                    Visibility="{Binding ShowAuto, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Automatic clean">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AutoText}" FontFamily="{StaticResource MonoFont}" FontSize="13" TextAlignment="Center" />
                    <Button Content="{Binding AutoCancelText}" Command="{Binding CancelAutoCommand}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Border>


            <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressFraction, Mode=OneWay}"
                             AutomationProperties.Name="Progress" />
                <TextBlock Text="{Binding OperationText}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding LiveStatsText}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,2,0,0"
                           Visibility="{Binding LiveStatsText, Converter={StaticResource NotEmptyToVisibility}}" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Center" Margin="0,14,0,0"
                        AutomationProperties.Name="Cancel the current operation" />
            </StackPanel>

            <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Cleanup result">
                <TextBlock Text="{Binding Headline}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Light"
                           TextAlignment="Center" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" TextAlignment="Center" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Content="View details" Command="{Binding ViewDetailsCommand}" Margin="0,0,8,0" />
                    <Button Content="Done" Command="{Binding DoneCommand}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" TextAlignment="Center" />
            </StackPanel>

            <Border Margin="0,16,0,0" Padding="14,10" CornerRadius="12" Background="{DynamicResource ErrorBackgroundBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Error">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalAlignment="Center" MaxWidth="720" HorizontalAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="[ TARGETS ]" Style="{StaticResource SectionTitle}" Margin="2,0,0,12" />

                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryRowViewModel}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="18,11" AutomationProperties.Name="{Binding AutomationName}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MaxWidth="280" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource StatusDot}" />
                                    <views:Spinner VerticalAlignment="Center" HorizontalAlignment="Left"
                                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource StatusText}"
                                               VerticalAlignment="Center" Margin="16,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="18,11"
                        Visibility="{Binding ShowRam, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Memory">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="MEMORY" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="{Binding RamText}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Free up RAM" Command="{Binding FreeRamCommand}" VerticalAlignment="Center" Margin="16,0,0,0"
                                ToolTip="Asks Windows to release RAM held by idle programs. Nothing is closed. The effect is partly temporary."
                                AutomationProperties.HelpText="Releases memory held by idle programs without closing anything." />
                    </Grid>
                </Border>

                <Button Style="{StaticResource LinkButton}" Content="{Binding ReviewRegistryText}" Command="{Binding ReviewRegistryCommand}"
                        HorizontalAlignment="Left" Margin="2,6,0,0"
                        Visibility="{Binding HasRegistryIssues, Converter={StaticResource BoolToVisibility}}" />

                <Border Margin="0,10,0,0" Padding="16,10" CornerRadius="12" Background="{DynamicResource InfoBackgroundBrush}"
                        Visibility="{Binding ShowAdminHint, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding AdminHint}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Run as administrator" Command="{Binding RestartAsAdministratorCommand}"
                                VerticalAlignment="Center" Margin="16,0,0,0"
                                AutomationProperties.HelpText="Windows will ask for permission before Clenzy restarts." />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
