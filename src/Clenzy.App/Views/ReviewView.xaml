<UserControl x:Class="Clenzy.App.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Clenzy.Presentation.ViewModels;assembly=Clenzy.Presentation">
    <DockPanel Margin="40,8,40,24" MaxWidth="1100">
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{Binding PermanentWarning}" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,0,0,8"
                           Visibility="{Binding HasPermanentSelection, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SecondaryText}" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" IsCancel="True"
                            AutomationProperties.Name="Cancel and change nothing" />
                    <Button Style="{StaticResource AccentButton}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
                            AutomationProperties.Name="{Binding ConfirmText}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel>
                <TextBlock Text="{Binding Intro}" Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,8" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource LinkButton}" Content="Select all" Click="SelectAll_Click" />
                    <Button Style="{StaticResource LinkButton}" Content="Select none" Click="SelectNone_Click" Margin="8,0,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ReviewSectionViewModel}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False" IsTabStop="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ReviewItemViewModel}">
                                            <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                                                          AutomationProperties.Name="{Binding Category}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Category}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource SecondaryText}" />
                                                            <TextBlock Text="{Binding Note}" Style="{StaticResource SecondaryText}"
                                                                       Visibility="{Binding Note, Converter={StaticResource NotEmptyToVisibility}}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding SizeText}" TextAlignment="Right" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding RiskText}" Style="{StaticResource RiskText}" TextAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
