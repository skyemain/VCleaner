<Window x:Class="CleanSlate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CleanSlate.App.Views"
        xmlns:vm="clr-namespace:CleanSlate.Presentation.ViewModels;assembly=CleanSlate.Presentation"
        Title="CleanSlate" Width="560" Height="800" MinWidth="440" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}" TextElement.Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="Assets/CleanSlate.ico"
        AutomationProperties.Name="CleanSlate">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ReviewViewModel}"><views:ReviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DetailsViewModel}"><views:DetailsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegistryReviewViewModel}"><views:RegistryReviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="24,12,16,8" Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/CleanSlate.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="CleanSlate" Style="{StaticResource PageTitle}" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Content="&#xE713;" HorizontalAlignment="Right"
                    Command="{Binding OpenSettingsCommand}" ToolTip="Settings"
                    AutomationProperties.Name="Settings" />
        </Grid>

        <Grid Margin="16,12,24,8" Visibility="{Binding IsHome, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" Command="{Binding CurrentPage.BackCommand}"
                    ToolTip="Back" AutomationProperties.Name="Back" />
            <TextBlock Grid.Column="1" Text="{Binding CurrentPage.Title}" Style="{StaticResource PageTitle}"
                       VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.HeadingLevel="Level1" />
        </Grid>

        <Grid Grid.Row="1">
            <views:HomeView Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}" />
            <ContentControl Content="{Binding CurrentPage}" IsTabStop="False"
                            Visibility="{Binding IsHome, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
    </Grid>
</Window>
