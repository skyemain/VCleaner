<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#0A8FC2</Color>
    <Color x:Key="HeroGlowColor">#2BB6E8</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EEF2F9" />
    <RadialGradientBrush x:Key="AmbientBrush" Center="0.2,0.5" GradientOrigin="0.2,0.5" RadiusX="0.65" RadiusY="0.95">
        <GradientStop Offset="0" Color="#3D4DD6FF" />
        <GradientStop Offset="0.55" Color="#1A8B6CFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="CardBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1A0B1B3A" />
    <SolidColorBrush x:Key="DividerBrush" Color="#160B1B3A" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#1F0B1B3A" />
    <SolidColorBrush x:Key="RingTrackBrush" Color="#260B1B3A" />
    <SolidColorBrush x:Key="TextBrush" Color="#0B1226" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#53607C" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#98A2B8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0A8FC2" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1AA3D8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0877A2" />
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#A9CFE0" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A0A8FC2" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeroTextBrush" Color="#0B1226" />
    <SolidColorBrush x:Key="HeroInnerBrush" Color="#E6FFFFFF" />
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#16B3E8" />
        <GradientStop Offset="1" Color="#6A4DF0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#3CC6F5" />
        <GradientStop Offset="1" Color="#8068FF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroPressedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#0A97C8" />
        <GradientStop Offset="1" Color="#5238D0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ControlBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#140B1B3A" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#260B1B3A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#0B7A3B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9A5B00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDE7E9" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#140B1B3A" />
    <SolidColorBrush x:Key="FocusBrush" Color="#0B1226" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8C95AB" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#53607C" />
</ResourceDictionary>
