<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#2F63EA</Color>
    <Color x:Key="HeroGlowColor">#3B76F5</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F6FA" />
    <SolidColorBrush x:Key="CardBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#14000000" />
    <SolidColorBrush x:Key="DividerBrush" Color="#14000000" />
    <SolidColorBrush x:Key="TextBrush" Color="#14161A" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5B6270" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#98A0AE" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2F63EA" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4573F0" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2552CC" />
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#9FB4EE" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A2F63EA" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeroTextBrush" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#3B76F5" />
        <GradientStop Offset="1" Color="#5B4EF0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#528BFF" />
        <GradientStop Offset="1" Color="#7064FF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroPressedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#2F63EA" />
        <GradientStop Offset="1" Color="#4A3FD0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ControlBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#0B7A3B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9A5B00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDE7E9" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#E8EFFD" />
    <SolidColorBrush x:Key="FocusBrush" Color="#14161A" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8C93A1" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#5B6270" />
</ResourceDictionary>
