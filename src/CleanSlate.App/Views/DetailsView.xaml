<UserControl x:Class="CleanSlate.App.Views.DetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CleanSlate.Presentation.ViewModels;assembly=CleanSlate.Presentation">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="24,8,24,24">
            <TextBlock Text="{Binding Summary}" FontSize="13" Margin="0,4,0,0" />

            <TextBlock Text="BY CATEGORY" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DetailRow}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="14,10"
                                AutomationProperties.Name="{Binding Category}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Category}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Group}" Style="{StaticResource SecondaryText}" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Recovered}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0">
                                    <Run Text="Found" /> <Run Text="{Binding Found, Mode=OneWay}" />
                                    <Run Text="  ·  Cleaned" /> <Run Text="{Binding Cleaned, Mode=OneWay}" />
                                    <Run Text="  ·  Skipped" /> <Run Text="{Binding Skipped, Mode=OneWay}" />
                                    <Run Text="  ·  Errors" /> <Run Text="{Binding Errors, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Note}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"
                                           Visibility="{Binding Note, Converter={StaticResource NotEmptyToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="SKIPPED AND ERRORS" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding ProblemsNote}" Style="{StaticResource SecondaryText}" Margin="4,0,0,6"
                           Visibility="{Binding ProblemsNote, Converter={StaticResource NotEmptyToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Problems}" Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DetailProblem}">
                            <Border Padding="4,6" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Message}" FontSize="12" />
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               ToolTip="{Binding Where}">
                                        <Run Text="{Binding Kind, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding Where, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
