<UserControl x:Class="CleanSlate.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CleanSlate.App.Views"
             xmlns:vm="clr-namespace:CleanSlate.Presentation.ViewModels;assembly=CleanSlate.Presentation">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="24,8,24,24" MaxWidth="640">

            <StackPanel HorizontalAlignment="Center" Margin="0,8,0,4">
                <Button Style="{StaticResource HeroButton}" Content="{Binding PrimaryButtonText}" Command="{Binding PrimaryCommand}"
                        HorizontalAlignment="Center" Margin="0,12,0,0"
                        AutomationProperties.Name="{Binding PrimaryButtonText}"
                        AutomationProperties.HelpText="Scans your PC, then removes the junk that is safe to remove." />
                <TextBlock Text="{Binding LastCleanedText}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                           TextAlignment="Center" Margin="0,22,0,0" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <ProgressBar IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressFraction, Mode=OneWay}"
                                 AutomationProperties.Name="Progress" />
                    <TextBlock Text="{Binding OperationText}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding LiveStatsText}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"
                               Visibility="{Binding LiveStatsText, Converter={StaticResource NotEmptyToVisibility}}" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                            AutomationProperties.Name="Cancel the current operation" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Cleanup result">
                <StackPanel>
                    <TextBlock Text="{Binding Headline}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="View details" Command="{Binding ViewDetailsCommand}" Margin="0,0,8,0" />
                        <Button Content="Done" Command="{Binding DoneCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource InfoBackgroundBrush}"
                    Visibility="{Binding ShowNotice, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" />
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource ErrorBackgroundBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Error">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" />
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,16,0,0" Focusable="False" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoryRowViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" AutomationProperties.Name="{Binding AutomationName}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MaxWidth="260" />
                                </Grid.ColumnDefinitions>
                                <views:Spinner VerticalAlignment="Center" HorizontalAlignment="Left"
                                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource StatusText}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource LinkButton}" Content="{Binding ReviewRegistryText}" Command="{Binding ReviewRegistryCommand}"
                    HorizontalAlignment="Left" Margin="4,4,0,0"
                    Visibility="{Binding HasRegistryIssues, Converter={StaticResource BoolToVisibility}}" />

            <Border Margin="0,16,0,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource InfoBackgroundBrush}"
                    Visibility="{Binding ShowAdminHint, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding AdminHint}" Style="{StaticResource SecondaryText}" FontSize="12" />
                    <Button Style="{StaticResource LinkButton}" Content="Restart as administrator..." Command="{Binding RestartAsAdministratorCommand}"
                            HorizontalAlignment="Left" Margin="-4,6,0,0"
                            AutomationProperties.HelpText="Windows will ask for permission before CleanSlate restarts." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
