<UserControl x:Class="CleanSlate.App.Views.RegistryReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CleanSlate.Presentation.ViewModels;assembly=CleanSlate.Presentation">
    <DockPanel Margin="40,8,40,24" MaxWidth="1100">
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Margin="0,0,0,10"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryText}" Margin="0,0,0,10"
                           Visibility="{Binding Message, Converter={StaticResource NotEmptyToVisibility}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Stop" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource AccentButton}" Content="{Binding RepairText}" Command="{Binding RepairCommand}"
                            AutomationProperties.Name="{Binding RepairText}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel>
                <TextBlock Text="{Binding Intro}" Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,8" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource LinkButton}" Content="Select all" Command="{Binding SelectAllCommand}" />
                    <Button Style="{StaticResource LinkButton}" Content="Select none" Command="{Binding SelectNoneCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Issues}" Margin="0,8,0,0" Focusable="False" IsTabStop="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RegistryIssueItemViewModel}">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                                          AutomationProperties.Name="{Binding Location}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource SecondaryText}" FontFamily="Consolas" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Evidence}" Style="{StaticResource SecondaryText}" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0">
                                            <Run Text="{Binding ProposedAction, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding ConfidenceText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,4,0,0"
                                                   Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="[ BACKUPS ]" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Backups are kept in CleanSlate's data folder. Restoring never overwrites an entry that now has different data."
                           Style="{StaticResource SecondaryText}" Margin="4,0,0,8" />
                <TextBlock Text="No backups yet." Margin="4,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasBackups}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Backups}" Focusable="False" IsTabStop="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RegistryBackupItemViewModel}">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Location}" FontFamily="Consolas" FontSize="12" />
                                        <TextBlock Text="{Binding CreatedText}" Style="{StaticResource SecondaryText}" />
                                        <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource ErrorBrush}" FontSize="12"
                                                   Visibility="{Binding Problem, Converter={StaticResource NotEmptyToVisibility}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Restore" Command="{Binding RestoreCommand}" VerticalAlignment="Center" Margin="12,0,0,0"
                                            AutomationProperties.Name="{Binding Location, StringFormat=Restore {0}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryText}" Margin="4,8,0,0"
                           Visibility="{Binding HasIssues, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
